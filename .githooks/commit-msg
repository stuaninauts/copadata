#!/bin/bash
# git commit-msg hook: Conventional Commits, lowercase, one-line subject, no body.
# Only blank lines and trailers (e.g. "Co-Authored-By: ...") may follow the subject.
# Enable once per clone: git config core.hooksPath .githooks

MSG_FILE="$1"
# drop comment lines (git strips them anyway) and trailing blank lines
mapfile -t LINES < <(grep -v '^#' "$MSG_FILE" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
SUBJECT="${LINES[0]}"

# messages generated by git itself
if grep -qE '^(Merge |Revert "|fixup! |squash! |amend! )' <<<"$SUBJECT"; then
  exit 0
fi

TYPES='feat|fix|docs|test|refactor|perf|chore|build|ci|style|revert'
fail() {
  echo "commit-msg: $1" >&2
  echo "  expected: <type>(<scope>): <lowercase description>   types: ${TYPES//|/, }" >&2
  echo "  got:      $SUBJECT" >&2
  exit 1
}

grep -qE "^(${TYPES})(\([a-z0-9-]+\))?!?: [a-z0-9]" <<<"$SUBJECT" || fail "subject is not a lowercase Conventional Commit"
[ "${#SUBJECT}" -le 72 ] || fail "subject longer than 72 characters"
grep -qE '\.$' <<<"$SUBJECT" && fail "subject ends with a period"
grep -q $'\u2014' <<<"$SUBJECT" && fail "subject uses an em dash"

for line in "${LINES[@]:1}"; do
  [ -z "$line" ] && continue
  grep -qE '^[A-Za-z][A-Za-z-]*: .+' <<<"$line" || fail "no body allowed (only trailers after the subject): '$line'"
done
exit 0
