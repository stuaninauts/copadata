---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { otherLang, t, type Lang, type Section } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** The same page in the other language (ADR 0010: every page exists in both); none for the 404. */
  alternate?: string;
  title?: string;
  description?: string;
  section?: Section;
}

const { lang, alternate, title, description = t(lang, 'site.description'), section } = Astro.props;
const fullTitle = title ? `${title} · CopaData` : 'CopaData';
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = otherLang(lang);
const hreflang = (l: Lang) => (l === 'pt' ? 'pt-BR' : 'en');
---

<!doctype html>
<html lang={hreflang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && (
      <>
        <link rel="alternate" hreflang={hreflang(lang)} href={canonical} />
        <link rel="alternate" hreflang={hreflang(other)} href={new URL(alternate, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={lang === 'pt' ? canonical : new URL(alternate, Astro.site)} />
      </>
    )}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f1ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1a18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CopaData" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(lang, 'og.alt')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} section={section} alternate={alternate}><slot name="localbar" /></Header>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
